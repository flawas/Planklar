# Vorlage: nach .env kopieren und Platzhalter ersetzen. Niemals echte Werte einchecken.

# Proxy
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Image
TAG=dev

# Datenbank (Werte müssen zu DATABASE_URL passen)
POSTGRES_USER=planklar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=planklar
DATABASE_URL=postgresql+psycopg://planklar:change-me@db:5432/planklar

# Queue
REDIS_URL=redis://redis:6379/0

# Objektspeicher (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret-min-8
S3_BUCKET=planklar
S3_REGION=us-east-1

# Anwendung
AUTH_SECRET=change-me-long-random-string
# Hinter http (lokal/CI) auf false setzen, mit TLS true.
AUTH_COOKIE_SECURE=false
RETENTION_DAYS=30

# KI-Modell
LLM_MODEL=
LLM_API_KEY=
