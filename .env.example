# Kopie als .env; nur Platzhalter, keine Secrets einchecken.
# Alle Werte sind optionale Overrides für docker-compose.yml.

# Proxy (Caddy): lokal :80 ohne TLS, in Produktion der Hostname (z. B. liquet.example.ch)
SITE_ADDRESS=:80
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
WEB_PORT=8000

# Anwendung
AUTH_SECRET=change-me
AUTH_COOKIE_SECURE=false
RETENTION_DAYS=30

# KI-Modell (LiteLLM); Vorgabe, im GUI unter /einstellungen/ki (Superuser) überschreibbar
LLM_MODEL=
LLM_API_KEY=

# Backup (scripts/backup.sh): Zielverzeichnis auf separatem Speicher, Aufbewahrung der Dumps in Tagen
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
