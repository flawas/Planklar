# Kopie als .env; nur Platzhalter, keine Secrets einchecken.
# Alle Werte sind optionale Overrides für docker-compose.yml.

# Proxy (Caddy): lokal :80 ohne TLS, in Produktion der Hostname (z. B. liquet.example.ch)
SITE_ADDRESS=:80
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
WEB_PORT=8000

# Objektspeicher (SeaweedFS): Zugangsdaten für App, Speicher und Backup; für Produktion ändern
S3_ACCESS_KEY=liquet
S3_SECRET_KEY=liquet
S3_PORT=8333

# Datenbank: die App läuft als Rolle liquet_app (ohne BYPASSRLS); Passwort für Produktion ändern
DB_APP_PASSWORD=liquet_app

# Anwendung
AUTH_SECRET=change-me
AUTH_COOKIE_SECURE=false
# E-Mail-Versand (Einladung, Passwort-Reset); ohne SMTP_HOST wird nichts versendet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
APP_BASE_URL=http://localhost:8080
RETENTION_DAYS=30

# KI-Modell (LiteLLM); Vorgabe, im GUI unter /einstellungen/ki (Superuser) überschreibbar
LLM_MODEL=
LLM_API_KEY=

# Backup (scripts/backup.sh): Zielverzeichnis auf separatem Speicher, Aufbewahrung der Dumps in Tagen
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
